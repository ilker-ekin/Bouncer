{
  "name": "bouncer",
  "version": "0.1.0",
  "description": "API gateway with per-tenant rate limiting (Redis) and tiered prioritization (RabbitMQ)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "demo": "tsx scripts/demo-overload.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "express": "^4.19.2",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
